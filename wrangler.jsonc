{
  "name": "thai-vi-portfolio",
  "account_id": "e87e6b4e7ec59834a35db192e7e37eb8",
  "compatibility_date": "2026-08-06",
  "main": "./worker.js",
  "assets": {
    "directory": "./",
    "binding": "ASSETS"
  },
  "kv_namespaces": [
    {
      "binding": "VI_PORTFOLIO_KV",
      "id": "d51a0de195b34f94b91c86480c68e831"
    }
  ],
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "persist": true,
      "invocation_logs": true
    },
    "traces": {
      "enabled": false,
      "persist": true,
      "head_sampling_rate": 1
    }
  }
}
